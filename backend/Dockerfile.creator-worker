FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tini && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/package.json
RUN npm ci --workspace backend --omit=dev
# Some installer archives ship ffprobe as owner-executable only. Runtime is node,
# not root; normalize both media binaries before switching users.
RUN node -e "for (const name of ['@ffmpeg-installer/ffmpeg','@ffprobe-installer/ffprobe']) require('node:fs').chmodSync(require(name).path, 0o755)"
COPY --chown=node:node backend ./backend
ENV NODE_ENV=production
USER node
WORKDIR /app/backend
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "src/creator-tools/worker.js"]
