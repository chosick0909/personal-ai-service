# Copy to the ignored .env.creator-tools for isolated staging only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
BRIGHT_DATA_API_KEY=
# Public account discovery requires a Bright Data SERP API zone plus Instagram profiles access.
BRIGHT_DATA_SERP_ZONE=
BRIGHT_DATA_PROFILES_DATASET=gd_l1vikfch901nx3by4
BRIGHT_DATA_REELS_DATASET=gd_lyclm20il4r5helnj
META_GRAPH_VERSION=
CREATOR_TOKEN_KEY=
CREATOR_REDIS_URL=
CREATOR_TOOLS_ENABLED=false
# Staff review only. This bypasses existing-plan checks for Creator Studio requests.
CREATOR_TOOLS_BYPASS_ENTITLEMENT=false
VITE_CREATOR_TOOLS_BYPASS_ENTITLEMENT=false
CREATOR_TOOLS_FEATURES=reference-accounts,trend-keywords,import-link,media-analyze,media-render
CREATOR_TOOLS_USER_IDS=
CREATOR_TOOLS_ROLLOUT_PERCENT=0
CREATOR_PROVIDER_DAILY_CALLS=500
# Optional model override; omission uses the existing configured chat model.
CREATOR_TEXT_MODEL=
# Per worker instance, 1..8. Scale only after CPU/RAM/tmp and provider capacity checks.
CREATOR_WORKER_CONCURRENCY=1

# Operator-reviewed catalog seeding: estimate first, explicit approval before paid calls.
CREATOR_CATALOG_CATEGORY_MAX_USD=2
CREATOR_CATALOG_CATEGORY_MAX_CALLS=100
CREATOR_CATALOG_POLL_MS=30000
# Required conservative reservation prices; fill from the actual provider contract.
CREATOR_CATALOG_SEARCH_USD=
CREATOR_CATALOG_PROFILE_USD=
CREATOR_CATALOG_REEL_USD=
CREATOR_CATALOG_RANK_USD=
